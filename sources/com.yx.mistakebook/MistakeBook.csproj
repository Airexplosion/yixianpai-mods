<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>MistakeBook</AssemblyName>
    <Version>0.1.1</Version>
    <DebugType>none</DebugType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <YxRefs Condition="'$(YxRefs)' == ''">../yixianpai-mod-sdk/refs</YxRefs>
    <CanjuDir Condition="'$(CanjuDir)' == ''">../research/world-boss/canju-0.2.26/com.yx.canju</CanjuDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Yx.ModSdk.Core"><HintPath>../yxp-mod-loader/sdk-bin/net40/Yx.ModSdk.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Yx.ModSdk"><HintPath>../yixianpai-mod-sdk/sdk/net40/Yx.ModSdk.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Canju"><HintPath>$(CanjuDir)/plugins/Canju.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(YxRefs)/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
