<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CanjuDir Condition="'$(CanjuDir)' == ''">../../research/world-boss/canju-release/com.yx.canju</CanjuDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Exercise.cs;../src/Sample.cs;../src/BattleJob.cs" />
    <Reference Include="Yx.ModSdk.Core"><HintPath>../../yxp-mod-loader/sdk-bin/netstandard2.0/Yx.ModSdk.Core.dll</HintPath></Reference>
    <Reference Include="Yx.ModSdk.Testing"><HintPath>../../yxp-mod-loader/sdk-bin/netstandard2.0/Yx.ModSdk.Testing.dll</HintPath></Reference>
    <Reference Include="Canju"><HintPath>$(CanjuDir)/plugins/Canju.dll</HintPath></Reference>
    <Reference Include="../../yixianpai-mod-sdk/refs/*.dll" />
    <Content Include="$(CanjuDir)/data/*.json" Link="data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CanjuDir)/native/YxBattleSim.dll" Link="YxBattleSim.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
